{
  "name": "reqman",
  "productName": "ReqMan",
  "version": "0.13.1",
  "description": "Local, Git-based requirements management tool (proof of concept)",
  "main": "./out/main/index.js",
  "author": "ReqMan",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "test:perf": "node -e \"process.env.PERF='1';require('child_process').execSync('npx vitest run tests/perf.test.ts',{stdio:'inherit',env:process.env})\"",
    "test:perf:all": "node -e \"process.env.PERF='all';require('child_process').execSync('npx vitest run tests/perf.test.ts',{stdio:'inherit',env:process.env})\"",
    "gen:repo": "tsx tools/generate-test-repo.mts",
    "test:e2e": "node e2e/run.mjs",
    "measure:ui": "node e2e/measure-tree.e2e.mjs",
    "gen:scenario": "tsx tools/generate-scenario-repo.mts",
    "check:deps": "node tools/check-deps.mjs",
    "prebuild": "node tools/check-deps.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "diff": "^9.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "globals": "^17.13.0",
    "jszip": "^3.10.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "saxes": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "xmllint-wasm": "^5.3.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
