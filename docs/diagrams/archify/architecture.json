  "cards": [
    {
      "dot": "emerald",
      "title": "Files are the truth",
      "items": [
        "Every item is a Markdown file in the project's own Git repository",
        "The SQLite index is only a cache, rebuilt from the files"
      ]
    },
    {
      "dot": "rose",
      "title": "Never lose work",
      "items": [
        "Writes are refused if the file changed since it was read",
        "Pushes are never forced; a pull that would clash stops first"
      ]
    },
    {
      "dot": "violet",
      "title": "One front door per module",
      "items": [
        "src/modules/<name>/index.ts is the only import",
        "main/composition.ts wires all implementations"
      ]
    }
  ]
