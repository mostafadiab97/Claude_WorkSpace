  "cards": [
    {
      "dot": "rose",
      "title": "Never overwrite someone's work",
      "items": [
        "If the file changed since it was opened (a pull, a colleague, an editor), the save is refused with a clear message",
        "A file ReqMan cannot read is never written over"
      ]
    },
    {
      "dot": "emerald",
      "title": "Never a half-written file",
      "items": [
        "The new content goes to a temporary file first, then replaces the old one in one step",
        "Short Windows locks (antivirus, OneDrive) are retried for about 1.5 s"
      ]
    }
  ]
