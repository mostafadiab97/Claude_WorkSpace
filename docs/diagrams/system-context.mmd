flowchart LR
  subgraph PC["Engineer's Windows PC"]
    U(["Engineer"])
    APP["ReqMan app<br/>(desktop, offline)"]
    WF[("Project repository folder<br/>requirements/ = item files + schema")]
    GIT["Git for Windows<br/>(+ Credential Manager)"]
    AD[("%APPDATA% › ReqMan<br/>index cache · logs · theme · recent")]
  end
  GH[("GitHub repository<br/>(shared copy, pull requests)")]
  REL[("GitHub Releases<br/>(installers, update feed)")]
  PC2["Colleague's PC<br/>(same setup)"]

  U -- "edits, links, commits, compares" --> APP
  APP -- "reads / writes plain files" --> WF
  APP -- "runs git commands" --> GIT
  GIT -- "status, commit, history" --> WF
  GIT -- "pull / push" --> GH
  APP -- "rebuildable cache, logs" --> AD
  APP -. "checks for updates" .-> REL
  PC2 -- "pull / push" --> GH
